generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Moneda {
  BOB
  USD
}

enum TipoMovimiento {
  DEPOSITO
  RETIRO
}

model Cuenta {
  id          Int          @id @default(autoincrement())
  numero      String       @unique
  clienteId   Int
  moneda      Moneda       @default(BOB)
  saldo       Decimal      @default(0) @db.Decimal(14, 2)
  activo      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  movimientos Movimiento[]
}

model Movimiento {
  id              Int            @id @default(autoincrement())
  cuentaId        Int
  tipo            TipoMovimiento
  monto           Decimal        @db.Decimal(14, 2)
  saldoResultante Decimal        @db.Decimal(14, 2)
  descripcion     String?
  fecha           DateTime       @default(now())
  cuenta          Cuenta         @relation(fields: [cuentaId], references: [id])

  @@index([cuentaId, fecha])
}
