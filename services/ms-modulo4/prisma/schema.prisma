generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TipoTransferencia {
  PROPIA
  TERCERO
  INTERBANCARIA
}

enum EstadoTransferencia {
  COMPLETADA
  RECHAZADA
  PENDIENTE
}

model Banco {
  id     Int    @id @default(autoincrement())
  codigo String @unique
  nombre String
}

model Transferencia {
  id                  Int                 @id @default(autoincrement())
  tipo                TipoTransferencia
  clienteId           Int
  cuentaOrigenId      Int
  cuentaDestinoNumero String
  bancoDestino        String?
  titularDestino      String?
  monto               Decimal             @db.Decimal(14, 2)
  glosa               String
  estado              EstadoTransferencia @default(PENDIENTE)
  codigoAch           String?             @unique
  claveIdempotencia   String?             @unique
  fecha               DateTime            @default(now())

  @@index([clienteId, fecha])
  @@index([cuentaOrigenId, fecha])
  @@index([estado, tipo])
}
