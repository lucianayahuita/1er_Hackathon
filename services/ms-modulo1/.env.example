PORT=3001
DATABASE_URL=postgresql://kata:kata@localhost:5433/db_modulo1
# Clave privada de firma JWT (mínimo 32 caracteres). Nunca incluir en el frontend.
JWT_SECRET=
JWT_TTL_SECONDS=3600
# Credenciales iniciales del administrador para ejecutar db:seed.
ADMIN_USUARIO=admin
ADMIN_PASSWORD=
# Clave para consultas HTTP de otros microservicios: GET /clientes/:id.
# Los servicios deben enviar X-Service-Key. No sirve para editar ni desbloquear.
INTERNAL_API_KEY=
