generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EstadoPrestamo {
  SOLICITADO
  APROBADO
  RECHAZADO
  DESEMBOLSADO
}

model Prestamo {
  id                 Int           @id @default(autoincrement())
  clienteId          Int
  cuentaDesembolsoId Int
  monto              Decimal       @db.Decimal(14, 2)
  tasaAnual          Decimal       @default(12.00) @db.Decimal(5, 2)
  plazoMeses         Int
  cuotaMensual       Decimal       @db.Decimal(14, 2)
  estado             EstadoPrestamo @default(SOLICITADO)
  activo             Boolean       @default(true)
  fecha              DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([clienteId])
  @@index([cuentaDesembolsoId])
  @@index([estado, activo])
}
